{
  "manifest_version": 3,
  "name": "Context Menu",
  "version": "1.0.0",
  "description": "A Chrome extension demonstrating right-click context menu",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Context Menu Demo"
  }
}
